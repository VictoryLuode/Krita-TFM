#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Source { uint pixels[]; } src;
layout(std430, binding = 1) writeonly buffer Output { uint pixels[]; } dst;
layout(std430, binding = 2) readonly buffer Parameters {
    int width;
    int height;
    float threshold;
    float radius;
    float intensity;
    float tintShift;
    float blend;
    int samples;
    float colorR;
    float colorG;
    float colorB;
    int channelR;
    int channelG;
    int channelB;
    int mode;
} p;

const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);

vec3 fetchPixel(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(p.width - 1, p.height - 1));
    uint v = src.pixels[c.y * p.width + c.x];
    return vec3(float((v >> 16u) & 255u), float((v >> 8u) & 255u), float(v & 255u));
}

void main() {
    ivec2 centre = ivec2(gl_GlobalInvocationID.xy);
    if (centre.x >= p.width || centre.y >= p.height) return;
    uint packed = src.pixels[centre.y * p.width + centre.x];
    float alpha = float((packed >> 24u) & 255u);
    vec3 base = fetchPixel(centre);

    // Gather the highlight energy of a large disc with a golden-angle spiral.
    // A single pass keeps this on the GPU with no intermediate readback; the
    // sampling density is what "Quality" controls.
    int samples = clamp(p.samples, 8, 64);
    float radius = max(0.0, p.radius);
    float sigma = max(1.0, radius * 0.45);
    float invTwoSigma2 = 1.0 / (2.0 * sigma * sigma);
    vec3 glow = vec3(0.0);
    float weightSum = 0.0;
    for (int i = 0; i < samples; ++i) {
        float t = float(i) + 0.5;
        float angle = t * 2.39996323;
        float distance = sqrt(t / float(samples)) * radius;
        ivec2 offset = ivec2(cos(angle) * distance, sin(angle) * distance);
        vec3 sampleValue = fetchPixel(centre + offset);
        float luminance = dot(sampleValue, kLuma) / 255.0;
        float energy = max(0.0, luminance - p.threshold);
        float w = energy * exp(-(distance * distance) * invTwoSigma2);
        glow += sampleValue * w;
        weightSum += w;
    }
    if (weightSum <= 0.0) {
        dst.pixels[centre.y * p.width + centre.x] = packed;
        return;
    }
    glow *= (float(samples) * 0.35) / max(weightSum, 1e-6);

    // Two mutually exclusive modes: pick a glow colour, or pick which channels
    // glow. Channel switches are ignored in colour mode and vice versa.
    vec3 tinted;
    if (p.mode == 1) {
        tinted = glow * vec3(p.channelR != 0 ? 1.0 : 0.0,
                             p.channelG != 0 ? 1.0 : 0.0,
                             p.channelB != 0 ? 1.0 : 0.0);
    } else {
        vec3 warm = glow * vec3(p.colorR, p.colorG, p.colorB);
        tinted = mix(glow, warm, clamp(p.tintShift, 0.0, 1.0));
    }
    tinted *= clamp(p.intensity, 0.0, 4.0);

    vec3 combined = 255.0 - (255.0 - base) * (255.0 - tinted) / 255.0;
    vec3 outC = clamp(mix(base, combined, clamp(p.blend, 0.0, 1.0)), 0.0, 255.0);
    dst.pixels[centre.y * p.width + centre.x] =
        (uint(round(alpha)) << 24u) | (uint(round(outC.r)) << 16u)
        | (uint(round(outC.g)) << 8u) | uint(round(outC.b));
}
