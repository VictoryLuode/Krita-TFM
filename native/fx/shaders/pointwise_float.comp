#version 450
// Float/HDR path for Vibrance, Temperature, Film Grain and Vignette.
// Storage is unassociated encoded RGBA F32 (same as EncodedRgbaImage).
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Source { vec4 pixels[]; } src;
layout(std430, binding = 1) writeonly buffer Output { vec4 pixels[]; } dst;
layout(std430, binding = 2) readonly buffer Parameters {
    int operation;
    int width;
    int height;
    int outputX;
    int outputY;
    int frameX;
    int frameY;
    int frameW;
    int frameH;
    int channel;
    int invert;
    int monochrome;
    int seed;
    float amount;
    float size;
    float factor;
    float feather;
    float roundness;
    float scaleX;
    float scaleY;
    float offsetX;
    float offsetY;
    float angle;
    float rangeMin;
    float rangeMax;
    float softness;
    float p0;
    float p1;
    float p2;
    float p3;
    float p4;
    float p5;
    float p6;
    float p7;
    int mode;
} p;

uint hash32(uint x, uint y, uint seed, uint channel) {
    uint h = x * 374761393u + y * 668265263u + seed * 2246822519u + channel * 3266489917u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    h ^= h >> 16u;
    return h;
}
float noise(int x, int y, int channel) {
    return float(hash32(uint(x), uint(y), uint(p.seed), uint(channel)) % 10000u) / 5000.0 - 1.0;
}

float smoothRange(float e0, float e1, float x) {
    if (e1 <= e0) return x < e0 ? 0.0 : 1.0;
    float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}
float valueNoise(float x, float y, int channel) {
    int x0 = int(floor(x));
    int y0 = int(floor(y));
    float fx = x - float(x0);
    float fy = y - float(y0);
    float sx = fx * fx * (3.0 - 2.0 * fx);
    float sy = fy * fy * (3.0 - 2.0 * fy);
    float n00 = noise(x0, y0, channel);
    float n10 = noise(x0 + 1, y0, channel);
    float n01 = noise(x0, y0 + 1, channel);
    float n11 = noise(x0 + 1, y0 + 1, channel);
    float nx0 = mix(n00, n10, sx);
    float nx1 = mix(n01, n11, sx);
    return mix(nx0, nx1, sy);
}
float grainResponse(float luma) {
    float shadows = 1.0 - smoothRange(0.0, 0.18, luma) * 0.15;
    float highlights = 1.0 - smoothRange(0.55, 0.95, luma) * 0.75;
    return clamp(shadows * highlights, 0.15, 1.15);
}
float filmGrainSample(float gx, float gy, int channel, bool mono) {
    float cell = max(0.5, p.size);
    float nx = gx / cell;
    float ny = gy / cell;
    if (mono) return valueNoise(nx, ny, 0);
    return valueNoise(nx, ny, 0) * 0.72 + valueNoise(nx, ny, channel) * 0.28;
}


float decodeSRGB(float encoded) {
    float v = abs(encoded);
    float lin = v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4);
    return sign(encoded) * lin;
}
float encodeSRGB(float linear) {
    float v = abs(linear);
    float enc = v <= 0.0031308 ? 12.92 * v : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
    return sign(linear) * enc;
}
vec3 decodeSRGB3(vec3 c) { return vec3(decodeSRGB(c.r), decodeSRGB(c.g), decodeSRGB(c.b)); }
vec3 encodeSRGB3(vec3 c) { return vec3(encodeSRGB(c.r), encodeSRGB(c.g), encodeSRGB(c.b)); }
vec3 linearToOkLab(vec3 c) {
    float l = 0.4122214708*c.r + 0.5363325363*c.g + 0.0514459929*c.b;
    float m = 0.2119034982*c.r + 0.6806995451*c.g + 0.1073969566*c.b;
    float s = 0.0883024619*c.r + 0.2817188376*c.g + 0.6299787005*c.b;
    float l_ = pow(l, 1.0/3.0), m_ = pow(m, 1.0/3.0), s_ = pow(s, 1.0/3.0);
    return vec3(
        0.2104542553*l_ + 0.7936177850*m_ - 0.0040720468*s_,
        1.9779984951*l_ - 2.4285922050*m_ + 0.4505937099*s_,
        0.0259040371*l_ + 0.7827717662*m_ - 0.8086757660*s_);
}
vec3 okLabToLinear(vec3 lab) {
    float l_ = lab.x + 0.3963377774*lab.y + 0.2158037573*lab.z;
    float m_ = lab.x - 0.1055613458*lab.y - 0.0638541728*lab.z;
    float s_ = lab.x - 0.0894841775*lab.y - 1.2914855480*lab.z;
    float l = l_*l_*l_, m = m_*m_*m_, s = s_*s_*s_;
    return vec3(
        +4.0767416621*l - 3.3077115913*m + 0.2309699292*s,
        -1.2684380046*l + 2.6097574011*m - 0.3413193965*s,
        -0.0041960863*l - 0.7034186147*m + 1.7076147010*s);
}

float rangeDistance(float v,float lo,float hi) { if(lo>hi){float t=lo;lo=hi;hi=t;} if(v<lo)return lo-v; if(v>hi)return v-hi; return 0.0; }
vec3 hsv(vec3 c) {
    float mx=max(c.r,max(c.g,c.b)), mn=min(c.r,min(c.g,c.b)), d=mx-mn;
    float h=0.0;
    if(d>0.0) { if(mx==c.r) h=mod((c.g-c.b)/d,6.0); else if(mx==c.g) h=(c.b-c.r)/d+2.0; else h=(c.r-c.g)/d+4.0; h/=6.0; if(h<0.0)h+=1.0; }
    return vec3(h, mx<=0.0?0.0:d/mx, mx);
}
float hueDistance(float a,float b) { float d=abs(a-b); return min(d,1.0-d); }
const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);
vec3 kelvin(float kelvinValue) {
    float t = clamp(kelvinValue, 1000.0, 40000.0) / 100.0;
    float rr, gg, bb;
    if (t <= 66.0) {
        rr = 255.0;
        gg = 99.4708025861 * log(t) - 161.1195681661;
        bb = t <= 19.0 ? 0.0 : 138.5177312231 * log(t - 10.0) - 305.0447927307;
    } else {
        rr = 329.698727446 * pow(t - 60.0, -0.1332047592);
        gg = 288.1221695283 * pow(t - 60.0, -0.0755148492);
        bb = 255.0;
    }
    return clamp(vec3(rr, gg, bb) / 255.0, 0.0, 1.0);
}


vec3 decodeSRGB3_mask(vec3 c) {
    vec3 a = abs(c);
    vec3 lin = mix(a/12.92, pow((a+0.055)/1.055, vec3(2.4)), step(vec3(0.04045), a));
    return sign(c)*lin;
}
vec3 linearToOkLab_mask(vec3 c) {
    float l = 0.4122214708*c.r + 0.5363325363*c.g + 0.0514459929*c.b;
    float m = 0.2119034982*c.r + 0.6806995451*c.g + 0.1073969566*c.b;
    float s = 0.0883024619*c.r + 0.2817188376*c.g + 0.6299787005*c.b;
    float l_ = pow(l, 1.0/3.0), m_ = pow(m, 1.0/3.0), s_ = pow(s, 1.0/3.0);
    return vec3(0.2104542553*l_+0.7936177850*m_-0.0040720468*s_,
                1.9779984951*l_-2.4285922050*m_+0.4505937099*s_,
                0.0259040371*l_+0.7827717662*m_-0.8086757660*s_);
}

void main() {
    int x=int(gl_GlobalInvocationID.x), y=int(gl_GlobalInvocationID.y);
    if(x>=p.width || y>=p.height)return;
    vec4 pix=src.pixels[y*p.width+x];
    float r=pix.r, g=pix.g, b=pix.b, a=pix.a;
    if(p.operation==0) {
        // Film grain: value noise + tone response in encoded float space.
        int gx=p.outputX+x, gy=p.outputY+y;
        float luma=0.2126*r+0.7152*g+0.0722*b;
        float amp=clamp(p.amount,0.0,1.0)*grainResponse(luma);
        bool mono=p.monochrome!=0;
        float nr=filmGrainSample(float(gx),float(gy),1,mono);
        float ng=mono?nr:filmGrainSample(float(gx),float(gy),2,false);
        float nb=mono?nr:filmGrainSample(float(gx),float(gy),3,false);
        r+=nr*amp; g+=ng*amp; b+=nb*amp;
    } else if(p.operation==1) {
        float w=max(1.0,float(p.frameW)), h=max(1.0,float(p.frameH));
        float px=float(p.outputX)+float(x)+0.5, py=float(p.outputY)+float(y)+0.5;
        float rad=p.angle*0.0174532925199433, cs=cos(rad), sn=sin(rad);
        float nx=(px-float(p.frameX))/w-0.5-p.offsetX, ny=(py-float(p.frameY))/h-0.5-p.offsetY;
        float rx=(nx*cs+ny*sn)/max(0.0001,p.scaleX), ry=(-nx*sn+ny*cs)/max(0.0001,p.scaleY);
        float d=max(abs(rx)*2.0,abs(ry)*2.0)*(1.0-p.roundness)+length(vec2(rx,ry))*2.0*p.roundness;
        float edge=p.feather<=1e-6?(d>=1.0?1.0:0.0):clamp((d-(1.0-p.feather))/p.feather,0.0,1.0);
        // Mix geometric mask with a soft cos^4 optical falloff for natural corners.
        float optical=pow(1.0/sqrt(1.0+d*d),4.0);
        float mask=mix(edge,1.0-optical,0.35);
        float f=1.0-clamp(mask,0.0,1.0)*p.factor; r*=f;g*=f;b*=f;
    } else if(p.operation==3) {
        float blend=clamp(p.p2,0.0,1.0);
        float tint=clamp(p.p1,-100.0,100.0)/100.0;
        vec3 c=vec3(r,g,b);
        vec3 gain=kelvin(p.p0)/max(kelvin(6500.0),vec3(1e-4));
        gain.g*=1.0+tint*0.2;
        vec3 lin=decodeSRGB3(c);
        vec3 outLin=lin*gain;
        if(p.p3>0.5) { float l0=dot(lin,kLuma), l1=dot(outLin,kLuma); if(l1>1e-5) outLin*=l0/l1; }
        // clip=false: retain HDR/negative via mix without clamp.
        vec3 outC=mix(c,encodeSRGB3(outLin),blend);
        r=outC.r; g=outC.g; b=outC.b;
    } else if(p.operation==2) {
        vec3 c = vec3(r, g, b);
        vec3 hv = hsv(c);
        float v;
        vec3 lab=linearToOkLab_mask(decodeSRGB3_mask(c));
        float okChroma=length(lab.yz);
        float okHue=atan(lab.z,lab.y)/6.283185307179586; if(okHue<0.0) okHue+=1.0;
        float deltaE=clamp(length(lab-vec3(0.5,0.0,0.0))/0.75,0.0,1.0);
        if(p.channel==0) v = dot(c, kLuma);
        else if(p.channel==1) v = c.r;
        else if(p.channel==2) v = c.g;
        else if(p.channel==3) v = c.b;
        else if(p.channel==4) v = hv.x;
        else if(p.channel==5) v = hv.y;
        else if(p.channel==6) v = clamp(lab.x,0.0,1.0);
        else if(p.channel==7) v = clamp(okChroma/0.4,0.0,1.0);
        else if(p.channel==8) v = okHue;
        else v = deltaE;
        float inside;
        if(p.channel==4 || p.channel==8) {
            bool inRange = p.rangeMin<=p.rangeMax ? (v>=p.rangeMin&&v<=p.rangeMax) : (v>=p.rangeMin||v<=p.rangeMax);
            float dist = inRange ? 0.0 : min(hueDistance(v,p.rangeMin), hueDistance(v,p.rangeMax));
            float sat = p.channel==4 ? hv.y : okChroma;
            inside = sat>1e-6 ? 1.0-smoothRange(0.0, max(1e-6, p.softness), dist) : 0.0;
        } else {
            inside = 1.0-smoothRange(0.0, max(1e-6, p.softness), rangeDistance(v, p.rangeMin, p.rangeMax));
        }
        float f = p.invert!=0 ? 1.0-inside : inside;
        a *= clamp(f, 0.0, 1.0);
    } else if(p.operation==4) {
        float vib=clamp(p.p0,-100.0,100.0)/100.0;
        float sat=clamp(p.p1,-100.0,100.0)/100.0;
        float protect=clamp(p.p2,0.0,1.0);
        float blend=clamp(p.p3,0.0,1.0);
        vec3 c=vec3(r,g,b);
        vec3 lin=decodeSRGB3(c);
        vec3 lab=linearToOkLab(lin);
        float chroma=length(lab.yz);
        float amt=vib*(1.0-min(chroma/0.4,1.0));
        if(protect>0.0) amt*=mix(1.0,0.0,smoothRange(0.70,1.0,lab.x)*protect);
        float gain=max(0.0,1.0+amt+sat);
        lab.yz*=gain;
        // clip=false: no clamp on HDR/negative channels.
        vec3 outC=mix(c,encodeSRGB3(okLabToLinear(lab)),blend);
        r=outC.r; g=outC.g; b=outC.b;
    } else {
        // Unsupported float op — pass through.
    }
    dst.pixels[y*p.width+x]=vec4(r,g,b,a);
}
