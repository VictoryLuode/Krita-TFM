#version 450
layout(local_size_x=16, local_size_y=16) in;
layout(std430,binding=0) readonly buffer Source { float pixels[]; } src;
layout(std430,binding=1) writeonly buffer Output { float pixels[]; } dst;
layout(std430,binding=2) readonly buffer Aux {
    int width, height, padding;
    float strength;
    float light[];
} aux;
vec4 fetchPixel(int x, int y) {
    int i = (y * aux.width + x) * 4;
    return vec4(src.pixels[i], src.pixels[i + 1], src.pixels[i + 2], src.pixels[i + 3]);
}
void writePixel(int x, int y, vec4 v) {
    int i = (y * aux.width + x) * 4;
    dst.pixels[i] = v.r;
    dst.pixels[i + 1] = v.g;
    dst.pixels[i + 2] = v.b;
    dst.pixels[i + 3] = v.a;
}
void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= aux.width || y >= aux.height) return;
    vec4 base = fetchPixel(x, y);
    if (base.a <= 0.0) {
        writePixel(x, y, base);
        return;
    }
    int i = (y * aux.width + x) * 3;
    vec3 glow = vec3(aux.light[i], aux.light[i + 1], aux.light[i + 2]) * clamp(aux.strength, 0.0, 2.0);
    vec4 outC = base;
    outC.rgb += glow;
    writePixel(x, y, outC);
}
