#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer Source { uint pixels[]; } src;
layout(std430, binding = 1) writeonly buffer Output { uint pixels[]; } dst;
layout(std430, binding = 2) readonly buffer Parameters {
    int operation;
    int width;
    int height;
    int outputX;
    int outputY;
    int frameX;
    int frameY;
    int frameW;
    int frameH;
    int channel;
    int invert;
    int monochrome;
    int seed;
    float amount;
    float size;
    float factor;
    float feather;
    float roundness;
    float scaleX;
    float scaleY;
    float offsetX;
    float offsetY;
    float angle;
    float rangeMin;
    float rangeMax;
    float softness;
} p;

uint hash32(uint x, uint y, uint seed, uint channel) {
    uint h = x * 374761393u + y * 668265263u + seed * 2246822519u + channel * 3266489917u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    h ^= h >> 16u;
    return h;
}
float noise(int x, int y, int channel) {
    return float(hash32(uint(x), uint(y), uint(p.seed), uint(channel)) % 10000u) / 5000.0 - 1.0;
}
float smoothRange(float e0, float e1, float x) {
    if (e1 <= e0) return x < e0 ? 0.0 : 1.0;
    float t = clamp((x - e0) / (e1 - e0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}
vec3 hsv(vec3 c) {
    float mx=max(c.r,max(c.g,c.b)), mn=min(c.r,min(c.g,c.b)), d=mx-mn;
    float h=0.0;
    if(d>0.0) { if(mx==c.r) h=mod((c.g-c.b)/d,6.0); else if(mx==c.g) h=(c.b-c.r)/d+2.0; else h=(c.r-c.g)/d+4.0; h/=6.0; if(h<0.0)h+=1.0; }
    return vec3(h, mx<=0.0?0.0:d/mx, mx);
}
float hueDistance(float a,float b) { float d=abs(a-b); return min(d,1.0-d); }
float rangeDistance(float v,float lo,float hi) { if(lo>hi){float t=lo;lo=hi;hi=t;} if(v<lo)return lo-v; if(v>hi)return v-hi; return 0.0; }
void main() {
    int x=int(gl_GlobalInvocationID.x), y=int(gl_GlobalInvocationID.y);
    if(x>=p.width || y>=p.height)return;
    uint packed=src.pixels[y*p.width+x];
    float a=float((packed>>24u)&255u), r=float((packed>>16u)&255u), g=float((packed>>8u)&255u), b=float(packed&255u);
    if(p.operation==0) {
        float amp=clamp(p.amount,0.0,1.0)*255.0;
        float sharedNoise=noise(int(floor(float(x)/max(0.5,p.size))),int(floor(float(y)/max(0.5,p.size))),0);
        r=clamp(r+(p.monochrome!=0?sharedNoise:noise(x,y,1))*amp,0.0,255.0);
        g=clamp(g+(p.monochrome!=0?sharedNoise:noise(x,y,2))*amp,0.0,255.0);
        b=clamp(b+(p.monochrome!=0?sharedNoise:noise(x,y,3))*amp,0.0,255.0);
    } else if(p.operation==1) {
        float w=max(1.0,float(p.frameW)), h=max(1.0,float(p.frameH));
        float px=float(p.outputX)+float(x)+0.5, py=float(p.outputY)+float(y)+0.5;
        float rad=p.angle*0.0174532925199433, cs=cos(rad), sn=sin(rad);
        float nx=(px-float(p.frameX))/w-0.5-p.offsetX, ny=(py-float(p.frameY))/h-0.5-p.offsetY;
        float rx=(nx*cs+ny*sn)/max(0.0001,p.scaleX), ry=(-nx*sn+ny*cs)/max(0.0001,p.scaleY);
        float d=max(abs(rx)*2.0,abs(ry)*2.0)*(1.0-p.roundness)+length(vec2(rx,ry))*2.0*p.roundness;
        float edge=p.feather<=1e-6?(d>=1.0?1.0:0.0):clamp((d-(1.0-p.feather))/p.feather,0.0,1.0);
        float f=1.0-edge*p.factor; r*=f;g*=f;b*=f;
    } else {
        vec3 c=vec3(r,g,b)/255.0; vec3 hv=hsv(c); float v;
        if(p.channel==0)v=0.2126*c.r+0.7152*c.g+0.0722*c.b;
        else if(p.channel==1)v=c.r; else if(p.channel==2)v=c.g; else if(p.channel==3)v=c.b; else if(p.channel==4)v=hv.x; else v=hv.y;
        float inside;
        if(p.channel==4) { bool inRange=p.rangeMin<=p.rangeMax?(v>=p.rangeMin&&v<=p.rangeMax):(v>=p.rangeMin||v<=p.rangeMax); float dist=inRange?0.0:min(hueDistance(v,p.rangeMin),hueDistance(v,p.rangeMax)); inside=hv.y>0.0?1.0-smoothRange(0.0,max(1e-6,p.softness),dist):0.0; }
        else inside=1.0-smoothRange(0.0,max(1e-6,p.softness),rangeDistance(v,p.rangeMin,p.rangeMax));
        float f=p.invert!=0?1.0-inside:inside; a=clamp(a*f,0.0,255.0);
    }
    uint packedOut=(uint(round(a))<<24u)|(uint(round(r))<<16u)|(uint(round(g))<<8u)|uint(round(b)); dst.pixels[y*p.width+x]=packedOut;
}
