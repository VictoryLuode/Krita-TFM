#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(std430,binding=0) readonly buffer Source { uint pixels[]; } src;
layout(std430,binding=1) writeonly buffer Output { uint pixels[]; } dst;
layout(std430,binding=2) readonly buffer Parameters {
 int sourceW,sourceH,frameX,frameY,frameW,frameH,outputX,outputY,outputW,outputH,horizontal,fit,jitter;
 float distortion,dispersion;
} p;
vec4 pixelAt(ivec2 xy) {
    uint pixel = src.pixels[xy.y * p.sourceW + xy.x];
    return vec4((pixel >> 16u) & 255u, (pixel >> 8u) & 255u, pixel & 255u, pixel >> 24u);
}

uint packPixel(vec4 color) {
    // U8 CPU uses lround for both the individual samples and the final colour.
    uvec4 channels = uvec4(floor(clamp(color, 0.0, 255.0) + 0.5));
    return (channels.a << 24u) | (channels.r << 16u) | (channels.g << 8u) | channels.b;
}

vec4 sampleBilinear(vec2 point) {
    ivec2 last = ivec2(p.sourceW - 1, p.sourceH - 1);
    if (any(lessThan(point, vec2(-0.5))) || any(greaterThan(point, vec2(last) + 0.5)))
        return vec4(0.0);
    vec2 position = clamp(point, vec2(0.0), vec2(last));
    ivec2 lo = ivec2(floor(position));
    ivec2 hi = min(lo + 1, last);
    vec2 fraction = position - vec2(lo);
    vec4 upper = mix(pixelAt(lo), pixelAt(ivec2(hi.x, lo.y)), fraction.x);
    vec4 lower = mix(pixelAt(ivec2(lo.x, hi.y)), pixelAt(hi), fraction.x);
    return floor(mix(upper, lower, fraction.y) + 0.5);
}

float jitterNoise(int x,int y,int seed){uint h=uint(x)*374761393u+uint(y)*668265263u+uint(seed)*2246822519u+71u*3266489917u;h=(h^(h>>13u))*1274126177u;h^=h>>16u;return float(h%10000u)/5000.-1.;}
int sampleCount(float lengthPixels) {
    if (p.jitter != 0) return lengthPixels < 4.0 ? 2 : int(sqrt(lengthPixels + 1.0));
    return max(1, int(lengthPixels + 1.0));
}
void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= p.outputW || y >= p.outputH) return;
    float w = float(p.frameW), h = float(p.frameH);
    float ix = float(p.outputX + x) + .5 - float(p.frameX);
    float iy = float(p.outputY + y) + .5 - float(p.frameY);
    float cx = w * .5, cy = h * .5;
    vec4 result;
    if (p.horizontal != 0) {
        float dx = p.dispersion * 5.0 / max(1.0, w);
        vec4 red = sampleBilinear(vec2((ix / w + dx) * w - .5, iy - .5));
        vec4 green = sampleBilinear(vec2(ix - .5, iy - .5));
        vec4 blue = sampleBilinear(vec2((ix / w - dx) * w - .5, iy - .5));
        result = vec4(red.r, green.g, blue.b, (red.a + green.a + blue.a) / 3.0);
    } else {
        float ri = clamp(p.distortion + p.dispersion / 4.0, -.999, 1.0);
        float bi = clamp(p.distortion - p.dispersion / 4.0, -.999, 1.0);
        float cr = ri * 4.0, cg = p.distortion * 4.0, cb = bi * 4.0;
        float mx = max(ri, max(p.distortion, bi));
        float scale = (p.fit != 0 && mx > 0.0) ? 1.0 / (1.0 + 2.0 * mx) : 1.0 / (1.0 + mx);
        vec2 uv = scale * (vec2(ix - cx, iy - cy) / vec2(cx, cy));
        float q = dot(uv, uv);
        if (cr * q > 1.0 || cg * q > 1.0 || cb * q > 1.0) {
            result = vec4(0.0);
        } else {
            float sr = (1.0 / (1.0 + sqrt(max(0.0, 1.0 - cr * q)))) * (1.0 + 0.08 * (cr * q) * q);
            float sg = (1.0 / (1.0 + sqrt(max(0.0, 1.0 - cg * q)))) * (1.0 + 0.08 * (cg * q) * q);
            float sb = (1.0 / (1.0 + sqrt(max(0.0, 1.0 - cb * q)))) * (1.0 + 0.08 * (cb * q) * q);
            int nr = sampleCount(length(uv * (sr - sg) * vec2(w, h)));
            int nb = sampleCount(length(uv * (sg - sb) * vec2(w, h)));
            vec4 sum = vec4(0.0);
            for (int i = 0; i < nr; ++i) {
                float t = (float(i) + (p.jitter != 0 ? (jitterNoise(int(ix), int(iy), i) + 1.0) * .5 : .5)) / float(nr);
                float v = cr + t * (cg - cr);
                float s = (1.0 / (1.0 + sqrt(max(0.0, 1.0 - v * q)))) * (1.0 + 0.08 * (v * q) * q);
                vec4 z = sampleBilinear((uv * s + .5) * vec2(w, h) - .5);
                sum.r += (1.0 - t) * z.r;
                sum.g += t * z.g;
                sum.a += z.a;
            }
            for (int i = 0; i < nb; ++i) {
                float t = (float(i) + (p.jitter != 0 ? (jitterNoise(int(ix), int(iy), nb + i) + 1.0) * .5 : .5)) / float(nb);
                float v = cg + t * (cb - cg);
                float s = (1.0 / (1.0 + sqrt(max(0.0, 1.0 - v * q)))) * (1.0 + 0.08 * (v * q) * q);
                vec4 z = sampleBilinear((uv * s + .5) * vec2(w, h) - .5);
                sum.g += (1.0 - t) * z.g;
                sum.b += t * z.b;
                sum.a += z.a;
            }
            result = vec4(sum.r * 2.0 / float(nr), sum.g * 2.0 / float(nr + nb), sum.b * 2.0 / float(nb), sum.a / float(nr + nb));
        }
    }
    dst.pixels[y * p.outputW + x] = packPixel(result);
}
